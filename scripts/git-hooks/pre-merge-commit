#!/usr/bin/env bash
# ============================================================
# scripts/git-hooks/pre-commit  (also installed as pre-merge-commit)
#
# 目的：在「提交的那一刻」拦住被官方更新冲掉的魔改。
# 这是第三层防线 —— 更新脚本的闸门只在跑脚本时生效，
# 手工 `git merge --continue` / 手工解决冲突后 commit 时就要靠它。
#
# 只查源码（快，约 1 秒），不查线上。
# 确实需要临时绕过时： git commit --no-verify
# ============================================================
set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
cd "$REPO_ROOT" || exit 0

# 仓库里没有体检脚本就放行（例如在旧分支上操作）
[ -x scripts/customizations-verify.sh ] || exit 0

# 只有涉及魔改相关文件时才体检，避免无关提交被拖慢
if git rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1; then
  : # 合并提交：一律体检（这正是最危险的时刻）
else
  changed=$(git diff --cached --name-only 2>/dev/null)
  case "$changed" in
    *backend/*|*frontend/*|*scripts/*|*CUSTOMIZATIONS.md*) : ;;
    *) exit 0 ;;
  esac
fi

out=$(./scripts/customizations-verify.sh 2>&1)
if [ $? -ne 0 ]; then
  printf '\n\033[1;31m[x] 提交被拦下：有魔改丢失。\033[0m\n\n' >&2
  printf '%s\n' "$out" | grep -E 'XX|丢失|结论' | sed 's/^/    /' >&2
  printf '\n\033[1;33m    逐条对照 CUSTOMIZATIONS.md 修好后再提交。\033[0m\n' >&2
  printf '\033[2m    确有需要临时绕过： git commit --no-verify\033[0m\n\n' >&2
  exit 1
fi
exit 0